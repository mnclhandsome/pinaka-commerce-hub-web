# Copy values into .env.development, .env.uat, or .env.production.
# Vite only exposes variables that start with VITE_.

VITE_APP_ENV=development
VITE_API_BASE_URL=/connector/api/v1
VITE_API_PROXY_TARGET=https://pch.alektasolutions.com

# For local development, point the general API proxy at merchant-service and
# the auth proxy at auth-service:
# VITE_API_BASE_URL=/api/v1
# VITE_API_PROXY_TARGET=http://localhost:3003
# VITE_AUTH_PROXY_TARGET=http://localhost:3010
